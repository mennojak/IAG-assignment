---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	ingest(ingest)
	draft(draft)
	extract(extract)
	ontology_check(ontology_check)
	evaluate(evaluate)
	revise(revise)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> ingest;
	draft --> extract;
	evaluate -.-> finish;
	evaluate -.-> revise;
	extract --> ontology_check;
	ingest --> draft;
	ontology_check --> evaluate;
	revise --> extract;
	finish --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
